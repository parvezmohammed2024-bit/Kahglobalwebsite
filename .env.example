# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD.
# Defaults to https://www.kahglobal.com.my when not set.
NEXT_PUBLIC_SITE_URL=https://www.kahglobal.com.my

# Admin panel (/admin) — set both in Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=choose-a-strong-password
# Long random string (32+ characters) used to sign the login cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Added automatically when you connect a Vercel Blob store (newer stores add
# BLOB_STORE_ID and use OIDC; older stores add BLOB_READ_WRITE_TOKEN).
# Needed locally only if you want to test saving from /admin.
BLOB_READ_WRITE_TOKEN=
